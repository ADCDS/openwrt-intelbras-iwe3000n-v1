// SPDX-License-Identifier: GPL-2.0
/*
 * Intelbras IWE 3000N v1 — RealTek RTL8196E Wi-Fi repeater.
 *
 * DRAFT. Not built, not booted. Derived from jnilo1/rtl8196e-gateway's
 * rtl8196e.dts (Lidl Silvercrest) with the board-specific parts replaced by
 * what was measured on the real unit; everything still unknown is marked TODO
 * rather than guessed.
 *
 * Measured on hardware, safe to rely on:
 *   - 32 MB DRAM on a 16-bit bus (loader banner "[16bit]", kernel "memory:
 *     02000000 @ 00000000")
 *   - console ttyS0 at 38400, from the stock kernel command line
 *   - Winbond W25Q32, JEDEC 0xEF4016, 4 MB, and the kernel logs
 *     "Force into Single IO Mode"
 *   - the LAN jack is a VLAN on the SoC switch, not a lone PHY:
 *     eth0 vid=9 member port 0x10f, eth1 vid=8 member port 0x110
 *
 * Not measured, deliberately absent:
 *   - LED and button GPIOs, now traced from the stock firmware: gpio 4 is the
 *     WPS button, gpio 13 the red LED, gpio 14 the blue LED. Exposed through
 *     &gpio0 below and driven from userspace (see files/rootfs). A wrong node
 *     is worse than having none.
 *   - There is no EFR32 radio on this board, so the upstream radio-bridge node
 *     is dropped rather than adapted.
 */
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "rtl819x.dtsi"

/ {
	compatible = "realtek,rtl8196e", "realtek,rtl819x-soc";
	model = "Intelbras IWE 3000N v1";

	chosen {
		bootargs = "console=ttyS0,38400 loglevel=7 root=/dev/mtdblock2 rootfstype=squashfs rtl8192ee.ips=0 rtl8192ee.fwlps=0 rtl8192ee.swlps=0";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x02000000>;	/* 32 MB, 16-bit bus */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Kept at the upstream addresses. `boothold` is a contract with
		 * jnilo1's replacement bootloader, which this board does NOT use --
		 * we keep the stock RealTek loader because mtd0 also holds this
		 * unit's MAC and RF calibration. Harmless to reserve; revisit if
		 * the 32 MB top ever needs reclaiming.
		 */
		boothold: boothold@1ffe000 {
			reg = <0x01FFE000 0x1000>;
			no-map;
		};

		wdtcrash: watchdog-crash@1ffd000 {
			reg = <0x01FFD000 0x1000>;
			no-map;
		};
	};

	/* LEDs are driven from userspace over /sys/class/gpio; see &gpio0. */
};

&uart0 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		/*
		 * The stock kernel reports the controller forced to single-IO and
		 * the vendor table shows chip_clk 0x4e. 25 MHz matches upstream and
		 * is conservative; raise only with evidence.
		 */
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * ⚠ 64 KB, read-only, and it must stay that way. Besides the
			 * bootloader this holds the H601 factory block at 0x6000 --
			 * two copies of the MAC (D8:77:8B:xx:xx:xx) and what looks
			 * like per-channel TX power calibration. There is no separate
			 * MAC partition on this board and nothing can regenerate it.
			 */
			partition@0 {
				label = "boot";
				reg = <0x000000 0x010000>;
				read-only;
			};

			/*
			 * Everything below differs from stock, which split this region
			 * 1028 KB kernel / 2.93 MB rootfs. A 6.18 kernel image is
			 * 1408 KB, so the boundary has to move.
			 */
			/*
			 * The boundary is 0x200000 because that is where the
			 * rootfs tooling burns (33-Rootfs/build_rootfs.sh
			 * passes -b 0x200000) and matching it costs nothing.
			 * It also leaves the kernel more room: the 6.18 image
			 * with CONFIG_PCI is 1480 KiB, so 1984 KiB is 75%
			 * used rather than 89%.
			 */
			partition@10000 {
				label = "kernel";
				reg = <0x010000 0x1F0000>;	/* 1984 KB */
			};

			partition@200000 {
				label = "rootfs";
				reg = <0x200000 0x190000>;	/* 1600 KB */
			};

			partition@390000 {
				label = "rootfs_data";
				reg = <0x390000 0x070000>;	/* 448 KB, ~= stock's 440 KB */
			};
		};
	};
};

/*
 * PCIe host, for the on-board RTL8192EE (10ec:818b).
 *
 * jnilo1's tree has no PCI support at all, so this node goes with
 * files/drivers/pci/controller/pci-rtl819x.c.
 *
 * The `soc` bus node in rtl819x.dtsi has no label, so it is re-opened through
 * the root. soc's ranges are <0x00000000 0x18000000 0x04000000>, so addresses
 * here are bus-relative: 0x00b00000 is physical 0x18b00000.
 *
 * Verified on hardware: this brings the link to LTSSM 0x11 and config dword 0
 * reads 0x818b10ec.
 */
/ {
	soc {
		pcie: pcie@b00000 {
			compatible = "realtek,rtl819x-pcie";
			reg = <0x00b00000 0x1000>,
			      <0x00b10000 0x1000>,
			      <0x00b01000 0x1000>;
			reg-names = "rc-cfg", "dev-cfg", "phy";

			/*
			 * The PCIe IP enable, the RTL8196E clock bits and PERST
			 * are all in the system controller's CLK_MANAGE, not in
			 * the PCIe block. Without the IP enable the block does
			 * not decode at all.
			 */
			realtek,syscon = <&sysc>;

			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x00 0x01>;

			/*
			 * ONE window, memory, at the memory aperture. From the
			 * RTL8196E's own bspchip.h:
			 *
			 *   BSP_PCIE0_D_IO  0xB8C00000  -> phys 0x18C00000
			 *   BSP_PCIE0_D_MEM 0xB9000000  -> phys 0x19000000
			 *
			 * The endpoint's MMIO BAR (BAR 2, the only one rtl8192ee
			 * uses) must land in the *memory* aperture so CPU reads
			 * reach it as memory transactions. The very first version
			 * of this node declared 0x18c00000 as memory; that is the
			 * I/O aperture, so BAR 2 was assigned there, every
			 * register access went out as an I/O TLP instead of a
			 * memory one, and the driver failed with
			 * "rtl8192ee: Init MAC failed" while the link trained and
			 * config space read fine throughout.
			 *
			 * No I/O range is declared, deliberately. The RTL8192EE
			 * advertises a 0x100-byte I/O BAR (BAR 0) that the driver
			 * never touches; leaving it unassigned costs nothing but a
			 * warning. Declaring an I/O range instead makes the
			 * generic host-bridge code call devm_pci_remap_iospace()
			 * -> vmap_page_range(), which BUGs on this Lexra MIPS --
			 * it has no PCI_IOBASE fixmap region to map the aperture
			 * into (kernel BUG at vmap_page_range, probe never
			 * returns). Memory-only is both sufficient and safe.
			 *
			 * Parent address is soc-bus-relative: soc's ranges are
			 * <0 0x18000000 0x04000000>, so 0x01000000 here is
			 * physical 0x19000000.
			 */
			ranges = <0x02000000 0x0 0x19000000
				  0x01000000
				  0x0 0x01000000>;

			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0>;
			/*
			 * The RTL8192EE's single INTA maps to the SoC intc at the
			 * PCIe GIMR/GISR bit, which is 21 -- NOT 14. 14 is the
			 * vendor's flat Linux-irq number for PCIe (bspchip.h
			 * BSP_PCIE_IRQ); the mainline realtek,rtl819x-intc uses the
			 * GIMR bit as its hwirq (ethernet is bit 15 = "interrupts =
			 * <15>"), and BSP_PCIE_IE is (1 << 21). Routing it to 14
			 * unmasked the wrong GIMR bit, so the endpoint asserted INTA
			 * forever (config status bit 3) while the CPU never saw it
			 * and the interrupt-driven beacon path never ran. The intc
			 * also has to route bit 21 to a CPU IP line; see the
			 * irq-rtl819x IRR2 patch.
			 */
			interrupt-map = <0 0 0 0 &intc 21>;

			status = "okay";
		};
	};
};

&ethernet {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * No lan-led-gpios here. Upstream's Lidl board drives a LAN LED from
	 * gpio0 14, but on this board line 14 is the blue panel LED (read from
	 * the stock firmware) and userspace owns it -- see &gpio0 below. Which
	 * line, if any, reflects link state here was never traced.
	 *
	 * The stock firmware brings up eth0 on vid 9 (member port 0x10f) and
	 * eth1 on vid 8 (member port 0x110), with peth0 mapped to eth1 and the
	 * single jack carrying eth1. Mirror that here once the upstream
	 * interface@N binding is understood.
	 */
};

&gpio0 {
	/*
	 * The SoC GPIO controller. Enabled so userspace can reach the panel
	 * button and LEDs over /sys/class/gpio (GPIO_SYSFS_LEGACY). Line names
	 * were read from the stock firmware's /sys/kernel/debug/gpio:
	 *   gpio 4  = WPS button (input, active low)
	 *   gpio 13 = red LED    (output)
	 *   gpio 14 = blue LED   (output)
	 * The rootfs drives these directly (see files/rootfs/sbin/led and
	 * etc/init.d/S60button); no gpio-keys/gpio-leds nodes, to keep the
	 * kernel under the loader's size ceiling.
	 */
	status = "okay";
	gpio-line-names =
		"", "", "", "",					/* 0-3   */
		"wps-button", "", "", "",			/* 4-7   */
		"", "", "", "",					/* 8-11  */
		"", "red-led", "blue-led", "";			/* 12-15 */
};
