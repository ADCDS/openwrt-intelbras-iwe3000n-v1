#!/bin/sh
# S90wifi -- bring the 2.4 GHz AP up at boot.
#
# Run by rcS after the base system is up (build.sh rootfs teaches upstream's
# rcS to run /etc/init.d/S??*; upstream only looks in /userdata, a partition
# this board does not have).
#
# Starts hostapd and a udhcpd DHCP server (192.168.50.100-200); the AP itself
# is 192.168.50.1. Clients can DHCP or use a static address in that /24. SSID
# and passphrase live in /etc/hostapd.conf; SSH is S50dropbear.
case "$1" in
start)
	if [ ! -d /sys/class/net/wlan0 ]; then
		echo "S90wifi: no wlan0, radio did not probe"
		exit 0
	fi
	ip link set wlan0 up
	ip addr add 192.168.50.1/24 dev wlan0 2>/dev/null
	mkdir -p /var/run
	if hostapd -B /etc/hostapd.conf; then
		echo "S90wifi: hostapd started, AP $(sed -n 's/^ssid=//p' /etc/hostapd.conf) on 192.168.50.1"
	else
		echo "S90wifi: hostapd failed to start"
	fi
	# DHCP server for clients on the AP. Needs wlan0 to already carry
	# 192.168.50.1 (set above); leases go to RAM.
	if [ -f /etc/udhcpd.conf ]; then
		: > /tmp/udhcpd.leases
		if command -v udhcpd >/dev/null 2>&1; then DHCPD="udhcpd"; else DHCPD="busybox udhcpd"; fi
		if $DHCPD /etc/udhcpd.conf; then
			echo "S90wifi: udhcpd serving 192.168.50.100-200"
		else
			echo "S90wifi: udhcpd failed to start"
		fi
	fi
	;;
stop)
	killall udhcpd 2>/dev/null
	killall hostapd 2>/dev/null
	ip link set wlan0 down 2>/dev/null
	;;
*)
	echo "usage: $0 start|stop"
	;;
esac
